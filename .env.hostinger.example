APP_NAME="Ridhi Sidhi Garments"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger MySQL — create DB in hPanel → Databases → MySQL Databases
# Host is usually localhost (or the host shown in hPanel)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_ridhi_sidhi
DB_USERNAME=u123456789_storeuser
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=brevo-api
MAIL_FROM_ADDRESS="support@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_QUEUE_NOTIFICATIONS=true

# Brevo
BREVO_ENABLED=true
BREVO_TRANSPORT=api
BREVO_API_KEY=
BREVO_SENDER_EMAIL="${MAIL_FROM_ADDRESS}"
BREVO_SENDER_NAME="${MAIL_FROM_NAME}"
BREVO_TIMEOUT=30
BREVO_MAX_RETRIES=3
BREVO_SMS_ENABLED=false
BREVO_WHATSAPP_ENABLED=false

STORE_SUPPORT_EMAIL="support@yourdomain.com"
STORE_SUPPORT_PHONE=9000000000

VITE_APP_NAME="${APP_NAME}"

SEO_SITE_NAME="${APP_NAME}"
SEO_DEFAULT_TITLE="Ridhi Sidhi Garments — Women’s Ethnic & Contemporary Clothing"
SEO_DEFAULT_DESCRIPTION="Shop thoughtfully selected kurtis, blouses, sarees, dresses, and women’s ethnic wear from Ridhi Sidhi Garments."
SEO_DEFAULT_KEYWORDS="women clothing, kurtis, readymade blouses, designer blouses, sarees, dresses, ethnic wear, traditional wear, Ridhi Sidhi Garments"
SEO_OG_IMAGE=/images/fashion-hero.svg
SEO_LOCALE=en_IN
SEO_ROBOTS=index,follow

# Shipping (flat charge per product unit unless overridden in the product)
DEFAULT_PRODUCT_SHIPPING=99
DEFAULT_DELIVERY_DAYS=5

# Razorpay — use live keys only with HTTPS
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK=false
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME="${APP_NAME}"

# Secret for /cron/sync-payments?token=...
CRON_SYNC_TOKEN=
